# Terraform working directories
**/.terraform/*

# Local state and locks
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans
*.tfplan
tfplan

# Local values and credentials
*.tfvars
*.tfvars.json
*.pem
*.key
.env
.env.*

# Crash logs
crash.log
crash.*.log

# Keep .terraform.lock.hcl in version control.
